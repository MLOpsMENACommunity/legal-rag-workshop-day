{
  "name": "w3-diagram-export",
  "private": true,
  "description": "Exports ../src/*.excalidraw to ../svg/*.svg with Excalidraw's own renderer",
  "scripts": {
    "bundle": "esbuild entry.js --bundle --format=iife --outfile=bundle.js --define:process.env.NODE_ENV='\"production\"' --loader:.woff2=file --loader:.css=empty --log-level=warning",
    "export": "node export_svg.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
